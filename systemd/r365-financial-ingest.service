[Unit]
Description=R365 financial ingest (source financial API -> PostgreSQL)
Documentation=file:///root/pos-analytics-pipeline-release/migrations/56_r365_financial.sql
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# Code runs from the clean release checkout (detached at a merged commit).
# /root/pos-analytics-pipeline holds unfinished pricing work and must never
# be the code path; only its shared venv interpreter is used, as laynes-api does.
Type=oneshot
WorkingDirectory=/root/pos-analytics-pipeline-release
# All logic lives in the orchestrator: Chicago/AYG-calendar targeting (chart of
# accounts + current and previous fiscal period; every elapsed period of the
# current and previous fiscal year on Mondays), flock, bounded HTTP retries,
# verbatim archive of summary responses, summary-vs-GL-detail reconciliation,
# replace-by-period upsert and the r365_financial_ingest_run record.
ExecStart=/root/pos-analytics-pipeline/venv/bin/python /root/pos-analytics-pipeline-release/r365_financial_ingest.py
# The orchestrator reads the credential from this root-only 0600 file itself.
# Deliberately NOT EnvironmentFile=, so it never appears in `systemctl show`
# or the journal.
Environment=R365_ENV_FILE=/etc/laynes/r365.env
Environment=R365_FIN_RAW_DIR=/var/lib/laynes/r365-financial/raw
Environment=R365_FIN_LOCK_PATH=/var/lib/laynes/r365-financial/state/ingest.lock
# ~15 requests on a normal day (~3 s observed), ~150 on a Monday repair.
TimeoutStartSec=1800
# Exit contract (see r365_financial_ingest.py):
#   0  every target COMPLETE (the open current period counts as expected)
#   1  a target FAILED (or configuration error)                 -- red
#   2  a CLOSED period PARTIAL at the source / store unaccounted -- red
#   75 another run holds the lock                                -- harmless
# The DATABASE is authoritative; read r365_financial_ingest_run.
SuccessExitStatus=0 75
StandardOutput=append:/var/lib/laynes/r365-financial/logs/financial-ingest.service.log
StandardError=append:/var/lib/laynes/r365-financial/logs/financial-ingest.service.log
