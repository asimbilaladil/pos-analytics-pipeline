# OnFailure= target for the monitor units: tells you the MONITOR failed (so its
# silence is not mistaken for "all clear"). Best effort; never fails itself.
[Unit]
Description=Laynes data monitor failure notice for %i

[Service]
Type=oneshot
WorkingDirectory=/root/pos-analytics-pipeline-release
EnvironmentFile=/etc/laynes/monitor.env
Environment=LAYNES_MONITOR_CONFIG=/etc/laynes/monitor.toml PYTHONDONTWRITEBYTECODE=1
ExecStart=-/root/pos-analytics-pipeline/venv/bin/python -m monitoring crash-notify %i
TimeoutStartSec=2min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/laynes/monitor
