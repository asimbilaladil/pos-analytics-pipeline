# /etc/laynes/monitor.env -- install mode 0600 root:root. NEVER commit real values.
# Only what the monitor needs: no read-write DB credentials, no model API keys.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laynes
# Analytics read-only role (the Revel check reuses chat_sql, which connects as it).
DB_RO_USER=laynes_ro
DB_RO_PASS=
# Monitor role: laynes_monitor once proposed_monitor_role.sql is approved and applied.
MONITOR_DB_USER=laynes_monitor
MONITOR_DB_PASS=
# Notifications (only after the destination is approved):
# MONITOR_TELEGRAM_BOT_TOKEN=
# MONITOR_TELEGRAM_CHAT_ID=
# MONITOR_SMTP_USER=
# MONITOR_SMTP_PASS=
